# Настройки сервера для compose.yml. На сервере: cp .env.deploy.example .env

# Домен сайта: Caddy сам получит для него HTTPS-сертификат. Локально — localhost.
SITE_ADDRESS=localhost
# Публичный адрес сайта: абсолютные ссылки в метатегах и письмах.
SITE_URL=https://localhost

# Пароль базы: длинный и случайный, например: openssl rand -base64 32
POSTGRES_PASSWORD=

# Подпись cookie сессий и ссылок из писем: openssl rand -base64 32.
# Если сменить, все выйдут из аккаунтов.
BETTER_AUTH_SECRET=

# Почта: SMTP-провайдер (Unisender, Yandex 360, Resend или другой). Порт 465 — сразу TLS,
# 587 — STARTTLS. Домен отправителя должен быть с SPF, DKIM и DMARC, иначе письма уйдут в спам.
# Для локальной проверки — Mailpit с компьютера: SMTP_HOST=host.docker.internal, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Odium <no-reply@example.com>
