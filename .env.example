# Пример переменных окружения. Для разработки: cp .env.example .env.local

# Публичный адрес сайта: абсолютные ссылки в метатегах и письмах
SITE_URL=http://localhost:3000

# PostgreSQL. Для разработки — из compose.dev.yml (npm run services:up)
DATABASE_URL=postgres://odium:odium@localhost:5432/odium
