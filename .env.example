# Пример переменных окружения. Для разработки: cp .env.example .env.local

# Публичный адрес сайта: абсолютные ссылки в метатегах и письмах
SITE_URL=http://localhost:3000

# PostgreSQL. Для разработки — из compose.dev.yml (npm run services:up)
DATABASE_URL=postgres://odium:odium@localhost:5432/odium

# Подпись cookie сессий и одноразовых ссылок. Для разработки подойдёт любая строка
# от 32 символов, на сервере — случайная: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789

# Почта. Для разработки — Mailpit из compose.dev.yml: письма видны на http://localhost:8025
# Адрес — 127.0.0.1, а не localhost: nodemailer ищет имя через DNS мимо /etc/hosts, и на localhost
# каждое первое письмо ждёт секунд пятнадцать.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Odium <no-reply@odium.local>
